# Copy this file to .env.local and fill in your values. Never commit real values.

# --- Required -----------------------------------------------------------------

# Postgres connection string (Neon or any Postgres). Used for leads, auth,
# course progress, CMS, and billing.
DATABASE_URL=postgresql://user:password@localhost:5432/brokerage

# Random 32+ character secret used to sign Better Auth sessions.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public base URL of the deployment; must match the auth callback origin.
BETTER_AUTH_URL=http://localhost:3004

# Canonical site URL used for metadata, sitemaps, emails, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Base URL used by a few course redirects (falls back to http://localhost:3000).
NEXT_PUBLIC_URL=http://localhost:3004

# --- API protection -----------------------------------------------------------

# API key required by GET /api/leads (lead retrieval for integrations).
LEADS_API_KEY=replace-with-a-random-api-key

# Shared secret that scheduled jobs send to /api/cron/* (Bearer token).
CRON_SECRET=replace-with-a-random-cron-secret

# --- Email (Resend) -----------------------------------------------------------

# Resend API key for transactional email (lead alerts, invites, digests).
RESEND_API_KEY=

# From address for outgoing email (onboarding@resend.dev works until you verify a domain).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives new-lead notifications.
LEAD_NOTIFY_EMAIL=owner@example.com

# --- Analytics (optional) -----------------------------------------------------

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). GA loads only when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Media (optional, build time) ---------------------------------------------

# Public CDN base URL that serves course audio at <url>/lessons/<slug>.mp3
# (for example a public Cloudflare R2 bucket). Leave blank to serve from /public.
AUDIO_CDN_URL=

# --- Stripe membership billing (optional) ---------------------------------------
# All three are required together. With any blank, /membership shows contact
# CTAs and every billing API answers 503. Use test-mode keys first.
# Register the webhook at <site>/api/billing/webhook for checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed and invoice.paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly membership price id (price_...).
STRIPE_PRICE_MEMBERSHIP_MONTHLY=

# --- Scripts only (optional) ----------------------------------------------------

# OpenAI key used only by scripts/generate-audio.mjs to synthesize lesson audio.
OPENAI_API_KEY=

# Bucket name used by scripts/upload-audio-r2.mjs (requires wrangler login).
R2_BUCKET=

# Throwaway database for the opt-in billing persistence tests
# (src/lib/billing/repository.db.test.ts). Never point this at real data.
TEST_DATABASE_URL=

# --- Set automatically by Vercel (informational) --------------------------------
# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA: used by /api/health and the production env guard.
